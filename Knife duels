UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if isBindingKey then
        local inputType = input.UserInputType
        local keyCode = input.KeyCode
        
        if inputType == Enum.UserInputType.Keyboard then
            Config.Keybind = keyCode
            BindBtn.Text = "Aimbot Key: [" .. keyCode.Name .. "]"
            isBindingKey = false
            Tween(BindBtn, {TextColor3 = Theme.TextWhite})
        elseif inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.MouseButton2 or inputType == Enum.UserInputType.MouseButton3 then
            Config.Keybind = inputType
            local name = (inputType == Enum.UserInputType.MouseButton1 and "L-Click") or (inputType == Enum.UserInputType.MouseButton2 and "R-Click") or "M-Click"
            BindBtn.Text = "Aimbot Key: [" .. name .. "]"
            isBindingKey = false
            Tween(BindBtn, {TextColor3 = Theme.TextWhite})
        elseif inputType.Name:match("Gamepad") then
            Config.Keybind = keyCode
            BindBtn.Text = "Aimbot Key: [" .. keyCode.Name .. "]"
            isBindingKey = false
            Tween(BindBtn, {TextColor3 = Theme.TextWhite})
        end
        return
    end

    if not gameProcessed then
        if input.KeyCode == Config.Keybind or input.UserInputType == Config.Keybind then
            isAimingKey = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if (input.KeyCode == Config.Keybind or input.UserInputType == Config.Keybind) then
        if MobileAimButton.Text ~= "LOCKED" then isAimingKey = false end
    end
end)

