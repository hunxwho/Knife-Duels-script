    btn.Text = text
    btn.TextColor3 = Theme.TextWhite
    btn.TextSize = 13
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.Border
    stroke.Parent = btn

    btn.MouseEnter:Connect(function() Tween(btn, {BackgroundColor3 = Theme.ToggleHover}, 0.15) Tween(stroke, {Color = Theme.TextDim}, 0.15) end)
    btn.MouseLeave:Connect(function() Tween(btn, {BackgroundColor3 = Theme.ToggleOff}, 0.15) Tween(stroke, {Color = Theme.Border}, 0.15) end)
    btn.MouseButton1Click:Connect(function()
        local originalColor = btn.TextColor3
        Tween(btn, {TextColor3 = Theme.Accent}, 0.1)
        task.wait(0.1)
        Tween(btn, {TextColor3 = originalColor}, 0.2)
        callback()
    end)
    return btn
end

