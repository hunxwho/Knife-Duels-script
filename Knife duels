    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local indicator = Instance.new("Frame")
    indicator.Parent = btn
    indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    indicator.BorderSizePixel = 0
    indicator.Size = UDim2.new(0, 3, 0.6, 0)
    indicator.Position = UDim2.new(0, -5, 0.2, 0)
    indicator.Visible = isFirst
    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(1, 0)
    indCorner.Parent = indicator
    local indGrad = Instance.new("UIGradient")
    indGrad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Theme.Accent),
        ColorSequenceKeypoint.new(1, Theme.AccentGlow)
    }
    indGrad.Parent = indicator

    local page = Instance.new("ScrollingFrame")
    page.Parent = Content
    page.BackgroundTransparency = 1
    page.Size = UDim2.new(1, 0, 1, 0)
    page.Visible = isFirst
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = Theme.Border
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y

    local layout = Instance.new("UIListLayout")
    layout.Parent = page
    layout.Padding = UDim.new(0, 14)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    Tabs[name] = page
    TabBtns[name] = {btn, indicator}

    btn.MouseButton1Click:Connect(function()
        for tName, tPage in pairs(Tabs) do
            local tBtnInfo = TabBtns[tName]
            if tName == name then
                tPage.Visible = true
                tBtnInfo[2].Visible = true
                Tween(tBtnInfo[1], {TextColor3 = Theme.TextWhite})
            else
                tPage.Visible = false
                tBtnInfo[2].Visible = false
                Tween(tBtnInfo[1], {TextColor3 = Theme.TextDim})
            end
        end
    end)
    return page
end

