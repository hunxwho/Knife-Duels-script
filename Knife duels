local function isPartVisible(targetPart, targetCharacter)
    if not Config.WallCheck then return true end
    local cam = Workspace.CurrentCamera
    if not cam then return false end
    local origin = cam.CFrame.Position
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.IgnoreWater = true
    local result = Workspace:Raycast(origin, targetPart.Position - origin, raycastParams)
    return (not result) or (result.Instance:IsDescendantOf(targetCharacter))
end

local function getClosestPlayer()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local screenCenter = cam.ViewportSize / 2
    local closestTarget = nil
    local shortestDistance = Config.FOVRadius

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if Config.TeamCheck and IsTeammate(player) then
                continue
            end
            
            if player.Character and player.Character:FindFirstChild(Config.TargetPart) and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                local targetPart = player.Character[Config.TargetPart]
                local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                if onScreen and isPartVisible(targetPart, player.Character) then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if distance < shortestDistance then
                        closestTarget = targetPart
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return closestTarget
end

-- ESP Rendering Management
local espCache = {}
local RigJoints = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
}
local R6Joints = {
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
}

local function getDrawings(player)
    if espCache[player] then return espCache[player] end
    local success, _ = pcall(function() return Drawing.new("Square") end)
    if not success then return nil end
    
    local drawings = { Box = Drawing.new("Square"), Skeleton = {} }
    drawings.Box.Thickness = 1.5
    drawings.Box.Color = Theme.TextWhite
    drawings.Box.Filled = false
    drawings.Box.Visible = false
    
    for i = 1, 14 do
        local line = Drawing.new("Line")
        line.Thickness = 1.5
        line.Color = Theme.TextWhite
        line.Visible = false
        table.insert(drawings.Skeleton, line)
    end
    espCache[player] = drawings
    return drawings
end

local function getESPFolder()
    local folder = ScreenGui:FindFirstChild("ESP_Layer")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "ESP_Layer"
        folder.Parent = ScreenGui
    end
    return folder
end

local function updateESP()
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local espFolder = getESPFolder()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local isFriendly = IsTeammate(player)
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChild("Humanoid")
            local drawings = getDrawings(player)
            local pName = tostring(player.UserId)

            if not isFriendly and char and root and head and hum and hum.Health > 0 then
                local rootPos, onScreen = cam:WorldToViewportPoint(root.Position)
                
                if drawings and Config.BoxESP and onScreen then
                    local headPos = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local legPos = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height * 0.6
                    drawings.Box.Size = Vector2.new(width, height)
                    drawings.Box.Position = Vector2.new(rootPos.X - width / 2, headPos.Y)
                    drawings.Box.Visible = true
                elseif drawings then drawings.Box.Visible = false end

                if drawings and Config.SkeletonESP and onScreen then
                    local isR15 = char:FindFirstChild("UpperTorso") ~= nil
                    local joints = isR15 and RigJoints or R6Joints
                    for i, line in ipairs(drawings.Skeleton) do
                        local connection = joints[i]
                        if connection then
                            local part1 = char:FindFirstChild(connection[1])
                            local part2 = char:FindFirstChild(connection[2])
                            if part1 and part2 then
                                local p1, vis1 = cam:WorldToViewportPoint(part1.Position)
                                local p2, vis2 = cam:WorldToViewportPoint(part2.Position)
                                if vis1 or vis2 then
                                    line.From = Vector2.new(p1.X, p1.Y)
                                    line.To = Vector2.new(p2.X, p2.Y)
                                    line.Visible = true
                                else line.Visible = false end
                            else line.Visible = false end
                        else line.Visible = false end
                    end
                elseif drawings then
                    for _, line in ipairs(drawings.Skeleton) do line.Visible = false end
                end
                
                if Config.ChamsESP then
                    local hl = espFolder:FindFirstChild(pName .. "_Chams")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = pName .. "_Chams"
                        hl.FillColor = Theme.Accent
                        hl.FillTransparency = 0.5
                        hl.OutlineColor = Theme.TextWhite
                        hl.OutlineTransparency = 0.2
                        hl.Parent = espFolder
                    end
                    hl.Adornee = char
                else
                    local hl = espFolder:FindFirstChild(pName .. "_Chams")
                    if hl then hl:Destroy() end
                end

                if Config.NameESP then
                    local bg = espFolder:FindFirstChild(pName .. "_Name")
                    if not bg then
                        bg = Instance.new("BillboardGui")
                        bg.Name = pName .. "_Name"
                        bg.Size = UDim2.new(0, 150, 0, 40)
                        bg.StudsOffset = Vector3.new(0, 2.5, 0)
                        bg.AlwaysOnTop = true
                        bg.Parent = espFolder
                        
                        local txt = Instance.new("TextLabel")
                        txt.Parent = bg
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.TextColor3 = Theme.TextWhite
                        txt.TextStrokeTransparency = 0.1
                        txt.Font = Enum.Font.GothamBold
                        txt.TextSize = 12
                    end
                    bg.Adornee = head
                    bg:FindFirstChildOfClass("TextLabel").Text = player.Name
                else
                    local bg = espFolder:FindFirstChild(pName .. "_Name")
                    if bg then bg:Destroy() end
                end
            else
                if drawings then
                    drawings.Box.Visible = false
                    for _, line in ipairs(drawings.Skeleton) do line.Visible = false end
                end
                local hl = espFolder:FindFirstChild(pName .. "_Chams")
                if hl then hl:Destroy() end
                local bg = espFolder:FindFirstChild(pName .. "_Name")
                if bg then bg:Destroy() end
            end
        end
    end
end

-- TRUE HITBOX EXPANSION & MASTER LOOP
local originalSizes = {}

RunService.RenderStepped:Connect(function()
    pcall(function()
        local cam = Workspace.CurrentCamera
        if not cam then return end

        local center = cam.ViewportSize / 2
        
        -- Update Native Drawing FOV if available, else update GUI FOV
        if FOVCircle then
            FOVCircle.Visible = Config.ShowFOV
            if Config.ShowFOV then
                FOVCircle.Position = center
                FOVCircle.Radius = Config.FOVRadius
            end
        elseif FOVFrame then
            FOVFrame.Visible = Config.ShowFOV
            if Config.ShowFOV then
                FOVFrame.Size = UDim2.new(0, Config.FOVRadius * 2, 0, Config.FOVRadius * 2)
                FOVFrame.Position = UDim2.new(0, center.X, 0, center.Y)
            end
        end

        local target = getClosestPlayer()

        -- Humanized Premium Aimbot Tracking
        if Config.Aimbot and isAimingKey and target then
            local jitterX = math.random(-10, 10) * 0.003
            local jitterY = math.random(-10, 10) * 0.003
            local jitterZ = math.random(-10, 10) * 0.003
            local humanizedPos = target.Position + Vector3.new(jitterX, jitterY, jitterZ)
            
            local newCFrame = CFrame.new(cam.CFrame.Position, humanizedPos)
            cam.CFrame = (Config.Smoothing >= 1.0) and newCFrame or cam.CFrame:Lerp(newCFrame, Config.Smoothing)
        end
        
        -- Physical Body Part Expansion
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                
                if not originalSizes[player.UserId] then 
                    originalSizes[player.UserId] = {} 
                end
                
                local partsToExpand = {"Head", "Torso", "UpperTorso", "LowerTorso"}
                local isTarget = false
                if Config.HitboxExpander and not IsTeammate(player) then
                    isTarget = true
                end
                
                for _, pName in ipairs(partsToExpand) do
                    local part = char:FindFirstChild(pName)
                    if part and part:IsA("BasePart") then
                        if not originalSizes[player.UserId][pName] then
                            originalSizes[player.UserId][pName] = part.Size
                        end

                        if isTarget and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                            part.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                            part.CanCollide = false
                            part.Massless = true
                            
                            if Config.ShowHitboxes then
                                part.Transparency = 0.5
                                part.Material = Enum.Material.ForceField
                                part.BrickColor = BrickColor.new("Royal purple")
                            else
                                part.Transparency = 1 
                            end
                        else
                            part.Size = originalSizes[player.UserId][pName]
                            part.Transparency = (pName == "HumanoidRootPart") and 1 or 0
                        end
                    end
                end
            end
        end

        -- Mobile Extra Features
        if isAimingKey and target and MobileAimButton.Text == "LOCKED" then
            local myChar = LocalPlayer.Character
            if myChar then
                if Config.MobileAutoJump then
                    local hum = myChar:FindFirstChildOfClass("Humanoid")
                    if hum and hum:GetState() ~= Enum.HumanoidStateType.Jumping and hum:GetState() ~= Enum.HumanoidStateType.Freefall then
                        hum.Jump = true
                    end
                end
                if Config.MobileAutoAttack then
                    local tool = myChar:FindFirstChildOfClass("Tool")
                    if tool then tool:Activate() end
                end
            end
        end

        updateESP()
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    if originalSizes[player.UserId] then
        originalSizes[player.UserId] = nil
    end
    if espCache[player] then
        pcall(function()
            espCache[player].Box:Remove()
            for _, line in ipairs(espCache[player].Skeleton) do line:Remove() end
        end)
        espCache[player] = nil
    end
end)
